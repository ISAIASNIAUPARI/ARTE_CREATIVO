# Público — visible en el navegador por diseño (Nivel 2, ver protocolo de ciberseguridad)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# ⚠️ SECRETO — Nivel 3, solo variables de entorno de servidor. Nunca con prefijo NEXT_PUBLIC_.
# Se usa solo en scripts/seed.mjs (Node, nunca llega al navegador).
SANITY_API_WRITE_TOKEN=

# ⚠️ SECRETO — Nivel 3. Token de rol "Viewer" para la vista previa en vivo del Studio
# (Presentation Tool). Necesario en local y en Vercel para que funcione el modo borrador.
SANITY_API_READ_TOKEN=
